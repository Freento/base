                <field id="list" translate="label" type="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label/>
                    <frontend_model>Freento\Base\Block\Adminhtml\System\Config\Recommended</frontend_model>
                </field>
            </group>
            <group id="notifications" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Notifications</label>
                <field id="content" translate="label" type="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label/>
                    <frontend_model>Freento\Base\Block\Adminhtml\System\Config\Notifications</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
